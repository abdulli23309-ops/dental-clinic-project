ENVIRONMENT=development
DEBUG=false
APP_NAME="Marlow Dental API"
API_V1_PREFIX=/api/v1

ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5433/dental_dev"

APPOINTMENTS_RATE_LIMIT="5/minute"

# Authentication & JWT
JWT_SECRET_KEY="generate-a-strong-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_ROTATE_AFTER_MINUTES=35
REFRESH_COOKIE_NAME="marlow_refresh_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
LOGIN_RATE_LIMIT="5/minute"
REFRESH_RATE_LIMIT="30/minute"

# Storage
UPLOAD_DIR="uploads"

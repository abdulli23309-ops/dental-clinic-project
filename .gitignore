# Root .gitignore for Marlow Dental Monorepo

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Environment and secrets
.env
.env.*
!.env.example

# Editor and IDE directories
.idea/
.vscode/
*.swp
*.swo

# Node / Frontend artifacts
node_modules/
.next/
out/
build/

# Python / Backend artifacts
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/
backend/uploads/
uploads/
